<% if (success && success.length) { %>
    <% success.forEach(message => { %>
        <div class="alert alert-success" role="alert">
            <%= message %>
        </div>
    <% }) %>
<% } %>
<% if (error && error.length) { %>
    <% error.forEach(message => { %>
        <div class="alert alert-danger" role="alert">
            <%= message %>
        </div>
    <% }) %>
<% } %>
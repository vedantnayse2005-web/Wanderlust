<% layout ("/layouts/boilerplate") %>


<div class = "row mt-5 mb-5">
  <div class = "col-lg-6 col-md-8 offset-lg-3 offset-md-2">

    <div class = "signup-card">

      <h2 class = "signup-title">📝 Sign Up</h2>
      <p class = "signup-subtitle">Create your account below</p>

      <form action="/users/signup" method="POST" class="needs-validation" novalidate>

        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input
            type="text"
            id="username"
            name="user[username]"
            class="form-control"
            placeholder="Enter your username"
            required
          >
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-feedback">Please enter a username.</div>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input
            type="email"
            id="email"
            name="user[email]"
            class="form-control"
            placeholder="Enter your email"
            required
          >
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-feedback">Please enter a valid email address.</div>
        </div>

        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input
            type="password"
            id="password"
            name="user[password]"
            class="form-control"
            placeholder="Enter your password"
            required
          >
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-feedback">Please enter a password.</div>
        </div>

        <button type="submit" class = "btn btn-primary w-100 mt-3">Sign Up</button>

      </form>

    </div>

  </div>

  <style> 
    /* ==========================================================================
   Signup — "Guest Pass" theme
   A signup card styled like a hotel key-card / boarding pass:
   torn perforated stub, mono ticket details, underline-style fields.
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap');

:root {
  --ink:        #1F3A3D;   /* deep teal-black, primary text/stub */
  --ink-soft:   #3C5457;
  --paper:      #EFE9DB;   /* warm plaster page background */
  --card:       #FFFDF8;   /* near-ivory card surface */
  --card-edge:  #E7E0CE;
  --gold:       #C08A28;   /* primary accent — CTA, focus */
  --gold-deep:  #9C6E1C;
  --sage:       #5C7A6B;   /* secondary accent — valid state */
  --rust:       #A44A3F;   /* invalid state, used sparingly */
  --line:       rgba(31, 58, 61, 0.16);
}

/* Page backdrop — quiet, textured, not the card itself */
body {
  background-color: var(--paper);
  background-image:
    radial-gradient(circle at 12% 8%, rgba(192, 138, 40, 0.08), transparent 40%),
    radial-gradient(circle at 88% 92%, rgba(92, 122, 107, 0.08), transparent 40%);
  background-attachment: fixed;
}

/* ---- Card shell ---------------------------------------------------- */

.signup-card {
  position: relative;
  display: grid;
  grid-template-columns: 64px 1fr;
  background: var(--card);
  border: 1px solid var(--card-edge);
  border-radius: 14px;
  box-shadow:
    0 1px 2px rgba(31, 58, 61, 0.06),
    0 18px 40px -20px rgba(31, 58, 61, 0.35);
  overflow: hidden;
  isolation: isolate;
}

/* Left stub: the "torn" edge of a key-card / ticket */
.signup-card::before {
  content: "GUEST · PASS";
  grid-column: 1;
  grid-row: 1 / -1;
  background: var(--ink);
  color: rgba(239, 233, 219, 0.75);
  font-family: 'Space Mono', monospace;
  font-size: 0.68rem;
  letter-spacing: 0.28em;
  writing-mode: vertical-rl;
  transform: rotate(180deg);
  text-align: center;
  padding: 28px 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Perforation between stub and body — punched circles showing page color */
.signup-card::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 64px;
  width: 0;
  border-left: 2px dashed rgba(239, 233, 219, 0.55);
  box-shadow: -1px 0 0 rgba(0, 0, 0, 0.06);
  background-image:
    radial-gradient(circle 5px, var(--paper) 5px, transparent 5.5px);
  background-size: 100% 26px;
  background-repeat: repeat-y;
  background-position: -5px 6px;
}

.signup-card > form,
.signup-card > .signup-title,
.signup-card > .signup-subtitle {
  grid-column: 2;
  padding-inline: 40px;
}

/* ---- Heading block --------------------------------------------------- */

.signup-title {
  margin: 34px 40px 2px;
  font-family: 'Fraunces', serif;
  font-style: italic;
  font-weight: 600;
  font-size: 2.05rem;
  color: var(--ink);
  letter-spacing: -0.01em;
}

.signup-title::before {
  content: "MEMBER SIGN-UP";
  display: block;
  font-family: 'Space Mono', monospace;
  font-style: normal;
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.24em;
  color: var(--gold-deep);
  margin-bottom: 10px;
}

.signup-subtitle {
  margin: 0 40px 28px;
  font-family: 'Inter', sans-serif;
  font-size: 0.92rem;
  color: var(--ink-soft);
  padding-bottom: 22px;
  border-bottom: 1px dashed var(--line);
}

/* ---- Form -------------------------------------------------------------- */

.signup-card form {
  padding-top: 4px;
  padding-bottom: 36px;
}

.signup-card .mb-3 {
  margin-bottom: 26px !important;
  position: relative;
}

.signup-card .form-label {
  font-family: 'Space Mono', monospace;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-soft);
  margin-bottom: 8px;
}

/* Underline-style fields — ticket "fill in the blank" look */
.signup-card .form-control {
  font-family: 'Inter', sans-serif;
  font-size: 1rem;
  color: var(--ink);
  background: transparent;
  border: none;
  border-bottom: 1.5px solid var(--line);
  border-radius: 0;
  padding: 8px 2px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.signup-card .form-control::placeholder {
  color: rgba(31, 58, 61, 0.32);
}

.signup-card .form-control:focus {
  outline: none;
  box-shadow: none;
  border-bottom-color: var(--gold);
  border-bottom-width: 2px;
}

.signup-card .form-control.is-valid,
.signup-card .form-control:valid:not(:placeholder-shown) {
  border-bottom-color: var(--sage);
}

.signup-card .form-control.is-invalid {
  border-bottom-color: var(--rust);
}

/* Feedback lines — small, iconic, not boxed alerts */
.signup-card .valid-feedback,
.signup-card .invalid-feedback {
  font-family: 'Inter', sans-serif;
  font-size: 0.78rem;
  margin-top: 6px;
  display: none;
}

.signup-card .form-control.is-valid ~ .valid-feedback,
.signup-card .form-control:valid:not(:placeholder-shown) ~ .valid-feedback {
  display: block;
  color: var(--sage);
}

.signup-card .form-control.is-invalid ~ .invalid-feedback {
  display: block;
  color: var(--rust);
}

.signup-card .valid-feedback::before { content: "✓  "; }
.signup-card .invalid-feedback::before { content: "!  "; }

/* ---- Submit button ------------------------------------------------- */

.signup-card .btn.btn-primary {
  font-family: 'Space Mono', monospace;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--card);
  background: var(--ink);
  border: none;
  border-radius: 999px;
  padding: 13px 24px;
  margin-top: 30px !important;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
}

.signup-card .btn.btn-primary::after {
  content: "→";
  font-family: 'Inter', sans-serif;
  transition: transform 0.2s ease;
}

.signup-card .btn.btn-primary:hover {
  background: var(--gold-deep);
  transform: translateY(-1px);
  box-shadow: 0 10px 22px -10px rgba(192, 138, 40, 0.55);
}

.signup-card .btn.btn-primary:hover::after {
  transform: translateX(3px);
}

.signup-card .btn.btn-primary:active {
  transform: translateY(0);
}

.signup-card .btn.btn-primary:focus-visible {
  outline: 2px solid var(--gold);
  outline-offset: 3px;
}

/* ---- Responsive: stub collapses to a top strip on narrow screens ---- */

@media (max-width: 576px) {
  .signup-card {
    grid-template-columns: 1fr;
  }

  .signup-card::before {
    grid-column: 1;
    grid-row: 1;
    writing-mode: horizontal-tb;
    transform: none;
    padding: 10px 0;
    font-size: 0.62rem;
  }

  .signup-card::after {
    left: 0;
    right: 0;
    top: 42px;
    bottom: auto;
    height: 0;
    border-left: none;
    border-top: 2px dashed rgba(239, 233, 219, 0.6);
    background-image: radial-gradient(circle 5px, var(--paper) 5px, transparent 5.5px);
    background-size: 26px 100%;
    background-repeat: repeat-x;
    background-position: 6px -5px;
  }

  .signup-card > form,
  .signup-card > .signup-title,
  .signup-card > .signup-subtitle {
    grid-column: 1;
    padding-inline: 26px;
  }

  .signup-title { margin-top: 26px; font-size: 1.7rem; }
}

/* ---- Motion preference ------------------------------------------------ */

@media (prefers-reduced-motion: reduce) {
  .signup-card .btn.btn-primary,
  .signup-card .btn.btn-primary::after,
  .signup-card .form-control {
    transition: none;
  }
}
  </style>
<% layout ("/layouts/boilerplate") %>

<div class="row mt-5 mb-5">
  <div class="col-lg-6 col-md-8 offset-lg-3 offset-md-2">
    <section class="login-card">
      <p class="login-eyebrow">WANDERLUST MEMBER ACCESS</p>
      <h1 class="login-title">Welcome back</h1>
      <p class="login-subtitle">Log in to continue your journey.</p>

      <form action="/users/login" method="POST">
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input type="text" id="username" name="username" class="form-control" autocomplete="username" required>
        </div>
        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn-primary w-100">Log In</button>
      </form>

      <p class="login-signup-link">New here? <a href="/users/signup">Create an account</a></p>
    </section>
  </div>
</div>

<style>
  .login-card {
    max-width: 560px;
    margin: 0 auto;
    padding: 42px clamp(24px, 7vw, 56px);
    background: #fffdf8;
    border: 1px solid #e7e0ce;
    border-top: 5px solid #1f3a3d;
    box-shadow: 0 18px 40px -20px rgba(31, 58, 61, 0.35);
  }

  .login-eyebrow {
    margin-bottom: 10px;
    color: #9c6e1c;
    font-family: 'Space Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .login-title {
    margin-bottom: 4px;
    color: #1f3a3d;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 2rem;
    font-style: italic;
  }

  .login-subtitle,
  .login-signup-link {
    color: #3c5457;
  }

  .login-subtitle {
    margin-bottom: 28px;
  }

  .login-card .form-label {
    color: #3c5457;
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .login-card .form-control {
    border: 0;
    border-bottom: 1px solid rgba(31, 58, 61, 0.2);
    border-radius: 0;
    background: transparent;
  }

  .login-card .form-control:focus {
    border-bottom: 2px solid #c08a28;
    box-shadow: none;
  }

  .login-card .btn-primary {
    margin-top: 14px;
    padding: 12px;
    border: 0;
    border-radius: 999px;
    background: #1f3a3d;
    font-family: 'Space Mono', monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .login-card .btn-primary:hover {
    background: #c08a28;
  }

  .login-signup-link {
    margin: 24px 0 0;
    text-align: center;
  }

  .login-signup-link a {
    color: #1f3a3d;
    font-weight: 600;
  }
</style>
<% layout("/layouts/boilerplate") %>

<div class="row mt-5 mb-5">
  <div class="col-lg-8 offset-lg-2">

    <!-- Hero Text -->
    <div class="text-center mb-5">
      <h1 class="home-title">Welcome to Wanderlust 🌍</h1>
      <p class="home-subtitle">Discover and manage beautiful listings with ease</p>
      <a href="/listings" class="btn btn-explore">View All Listings →</a>
    </div>

    <!-- Profile Card -->
    <div class="profile-card">
      <div class="profile-left">
        <img
          src="https://media.licdn.com/dms/image/v2/D4D03AQFf5Rhy6ofQjQ/profile-displayphoto-scale_400_400/B4DZ17SX2XIEAg-/0/1775889921199?e=1784160000&v=beta&t=J1dpjkUiNmtbCwE1WKkCL4FfHFUxEZC1Go3hK1YJpuU"
          alt="Vedant Nayse"
          class="profile-avatar"
        >
      </div>
      <div class="profile-right">
        <p class="profile-made">Made by</p>
        <h3 class="profile-name">Vedant R. Nayse</h3>
        <p class="profile-bio">Computer Science Student | Full-Stack Developer | Node.js, MongoDB & SQL</p>
        <a href="https://www.linkedin.com/in/vedant-nayse" target="_blank" class="linkedin-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"/>
          </svg>
          Connect on LinkedIn
        </a>
      </div>
    </div>

  </div>
</div>

<style>
  .home-title {
    font-size: 2.2rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 0.5rem;
  }

  .home-subtitle {
    color: #888;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

/*  */
  .btn-explore {
    background: #1a1a1a;
    color: #fff;
    border-radius: 8px;
    padding: 10px 24px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.2s;
  }

  .btn-explore:hover {
    background: #333;
    color: #fff;
  }

  .profile-card {
    display: flex;
    align-items: center;
    gap: 2rem;
    background: #fff;
    border-radius: 16px;
    padding: 2rem 2.5rem;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.09);
    border: 1px solid #f0f0f0;
  }

  .profile-avatar {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #0077b5;
  }

  .profile-made {
    font-size: 0.8rem;
    color: #aaa;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.2rem;
  }

  .profile-name {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 0.4rem;
  }

  .profile-bio {
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .linkedin-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #0077b5;
    color: #fff;
    text-decoration: none;
    padding: 8px 18px;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 600;
    transition: background 0.2s;
  }

  .linkedin-btn:hover {
    background: #005f91;
    color: #fff;
  }

  @media (max-width: 576px) {
    .profile-card {
      flex-direction: column;
      text-align: center;
      padding: 1.5rem;
    }
  }
</style>
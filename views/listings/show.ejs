<% layout("/layouts/boilerplate") %>

  <div class="row mt-5 mb-5">
    <div class="col-lg-6 col-md-8 offset-lg-3 offset-md-2">

      <div class="card show-card">

        <% if (listing.image?.contentType === 'application/pdf') { %>
          <div class="card-body">
            <iframe src="<%= listing.image.url %>" title="<%= listing.title %> PDF" style="width:100%;height:32rem;border:0;"></iframe>
            <a href="<%= listing.image.url %>" target="_blank" rel="noopener">Open PDF in a new tab</a>
          </div>
        <% } else { %>
          <img src="<%= listing.image?.url %>" class="card-img-top show-img" alt="<%= listing.title %>">
        <% } %>

        <div class="card-body">

          <h2 class="card-title">
            <%= listing.title %>
          </h2>

          <p class="card-text">
            <%= listing.description %>
          </p>
          <p class="text-muted">Listed by <strong><%= listing.owner?.username || "Unknown" %></strong></p>

          <div class="listing-meta mb-4">

            <div class="meta-row mb-2">
              <span class="meta-label">Price</span>
              <span class="price-badge">
                ₹<%= listing.price.toLocaleString("en-IN") %>
                  <span class="per-night">/ night</span>
              </span>
            </div>

            <div class="meta-row">
              <span class="meta-label">Location</span>
              <span class="location-tag">
                📍 <%= listing.location %>, <%= listing.country %>
              </span>
            </div>

          </div>
          <div class="d-flex gap-2 flex-wrap action-btns">
            <% if (currentUser && listing.owner && currentUser._id.equals(listing.owner._id)) { %>
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark btn-action">
              ✏️ Edit
            </a>
            <form action="/listings/<%= listing._id %>" method="POST">
              <input type="hidden" name="_method" value="DELETE">
              <button type="submit" class="btn btn-outline-danger btn-action">
                🗑️ Delete
              </button>
            </form>
            <% } %>
            <a href="/listings" class="btn btn-secondary btn-action">
              🏠 Home
            </a>
          </div>

        </div>

      </div>
      <div class="col-md-8 mx-auto">
        <hr>
        <h4>Leave a Review</h4>
        <% if (currentUser) { %>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
          <div class="rating-input mb-3">
            <label class="form-label">Rating</label>
            <div class="star-rating">
              <% for (let i = 1; i <= 5; i++) { %>
                <input type="radio" id="rating-<%= i %>" name="review[rating]" value="<%= i %>" class="star-radio" required>
                <label for="rating-<%= i %>" class="star-label" data-value="<%= i %>" title="<%= i %> stars">★</label>
              <% } %>
            </div>
            <div class="invalid-feedback">Please select a rating</div>
          </div>
          <div>
            <label for="comment" class="form-label">Comments</label>
            <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
            <div class="invalid-feedback">Please submit some comments for review</div>
          </div>
          <button class="btn btn-outline-dark">Submit</button>
        </form>
        <% } else { %>
          <p><a href="/users/login">Log in</a> to leave a review.</p>
        <% } %>
      </div>
      <hr>
    <h4>All Reviews</h4>
<div class="row">
  <% for(let review of listing.reviews){ %>
    <div class="col-md-6 mb-3">
      <div class="card review-card">
        <div class="card-body">

          <% const reviewerName = review.author?.username; %>
          <% if (reviewerName) { %>
          <div class="review-card-header">
            <div class="review-avatar"><%= reviewerName.slice(0, 2).toUpperCase() %></div>
            <p class="reviewer-name"><%= reviewerName %></p>
          </div>
          <% } %>

          <p class="review-comment"><%= review.comment %></p>

          <div class="review-stars">
            <% for(let i = 1; i <= 5; i++) { %>
              <span class="star <%= i <= review.rating ? 'filled' : '' %>">★</span>
            <% } %>
            <span class="review-rating-text"><%= review.rating %> stars</span>
          </div>

          <% if (currentUser && ((review.author && currentUser._id.equals(review.author._id)) || (listing.owner && currentUser._id.equals(listing.owner._id)))) { %>
          <div class="delete-review mt-3">
            <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>" method="POST">
              <input type="hidden" name="_method" value="DELETE">
              <button type="submit" class="btn btn-outline-danger">delete review</button>
            </form>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>
</div>

<script>
  document.querySelectorAll('.star-label').forEach(label => {
    label.addEventListener('click', () => {
        const clicked = parseInt(label.dataset.value);
        const allLabels = document.querySelectorAll('.star-label');

        allLabels.forEach(l => {
            l.classList.remove('selected');
            if (parseInt(l.dataset.value) <= clicked) {
                l.classList.add('selected');
            }
        });
    });

    label.addEventListener('mouseenter', () => {
        const hovered = parseInt(label.dataset.value);
        document.querySelectorAll('.star-label').forEach(l => {
            l.classList.remove('hovered');
            if (parseInt(l.dataset.value) <= hovered) {
                l.classList.add('hovered');
            }
        });
    });

    label.addEventListener('mouseleave', () => {
        document.querySelectorAll('.star-label').forEach(l => l.classList.remove('hovered'));
    });
});
</script>

